<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <interface name="interface2" label="Multi Script Editor" icon="MISC_python" help_url="">
    <script><![CDATA[# MultiScriptEditor for Houdini.
# by PaulWinex. www.paulwinex.com
# python_panel for Houdini 15 and up

def createInterface():
    import hou
    from multi_script_editor import scriptEditor
    w = scriptEditor.create_editor_instance()
    try:
        w.setStyleSheet(hou.ui.qtStyleSheet())
    except AttributeError:
        pass
    return w
]]></script>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
